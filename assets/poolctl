#!/bin/bash

script_name="poolctl"
base_url="<pool-url>"
install_path="/usr/local/bin/$script_name"
clipboard_file="$HOME/.pool/clipboard"

# Function to list files
list_files() {
    if [ -z "$1" ]; then
        output=$(curl -skL $base_url/ls)
    else
        output=$(curl -skL $base_url/ls/"$1")
    fi

    if command -v jq &> /dev/null; then
        echo $output | jq -r '.[] | "\(.name) \(.size_bytes)B \(.modification_time)"' | column -t
    else
        echo $output
    fi
}

# Function to get file contents (raw)
get_file() {
    if [ -z "$1" ]; then
        echo "Usage: $script_name get <filename>"
    else
        curl -skL $base_url/cat/"$1"
    fi
}

# Function to push a file
push_file() {
    if [ -z "$1" ]; then
        echo "Usage: $script_name push <path to file>"
    else
        curl -skL $base_url/push -F files=@"$1" > /dev/null
    fi
}

# Function to pull a file or files
pull_file() {
    if [ -z "$1" ]; then
        echo "Usage: $script_name pull <filename or pattern>"
    else
        curl -skL $base_url/pull/"$1" -O
    fi
}

# Function to remove a file or files
remove_file() {
    if [ -z "$1" ]; then
        echo "Usage: $script_name remove <filename or pattern>"
    else
        curl -skL $base_url/rm/"$1" > /dev/null
    fi
}

# Function to push clipboard contents
push_clipboard() {
    mkdir -p $(dirname $clipboard_file)

    if command -v xclip &> /dev/null; then
        xclip -o -selection clipboard > $clipboard_file
        curl -skL $base_url/push -F files=@"$clipboard_file" > /dev/null
    elif command -v pbpaste &> /dev/null; then
        pbpaste > $clipboard_file
        curl -skL $base_url/push -F files=@"$clipboard_file" > /dev/null
    else
        echo "xclip or pbcopy is required for this operation"
    fi
}

# Function to pull clipboard contents
pull_clipboard() {
    if command -v xclip &> /dev/null; then
        curl -skL $base_url/cat/clipboard | xclip -selection clipboard
    elif command -v pbcopy &> /dev/null; then
        curl -skL $base_url/cat/clipboard | pbcopy
    else
        echo "xclip or pbcopy is required for this operation"
    fi
}

# Function to install the script
install_script() {
    # Copy script to /usr/local/bin and make it executable
    sudo cp "$0" "$install_path"
    sudo chmod +x "$install_path"

    echo "Script installed to $install_path"
    echo "Add the following line to your .bashrc or .zshrc to use it from any location:"
    echo "export PATH=\"/usr/local/bin:\$PATH\""
}

# Function to display usage
display_usage() {
    echo "Usage: $script_name <command> [options]"
    echo
    echo "Commands:"
    echo "  ls|list <filename|pattern>   List file(s)"
    echo "  get|cat <filename>           Get file contents (raw)"
    echo "  push <path-to-file>          Push file"
    echo "  pull <filename|pattern>      Pull file(s)"
    echo "  rm|remove <filename|pattern> Remove file(s)"
    echo "  c|clipboard-push             Push clipboard contents"
    echo "  v|clipboard-pull             Pull clipboard contents"
    echo "  install                      Install this script"
    echo
}

# Main command handling
case "$1" in
    ls|list)
        list_files "$2"
        ;;
    cat|get)
        get_file "$2"
        ;;
    push)
        push_file "$2"
        ;;
    pull)
        pull_file "$2"
        ;;
    rm|remove)
        remove_file "$2"
        ;;
    install)
        install_script
        ;;
    c|clipboard-push)
        push_clipboard
        ;;
    v|clipboard-pull)
        pull_clipboard
        ;;
    *)
        display_usage
        ;;
esac
